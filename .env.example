# Copiar a .env y completar. El .env nunca se sube al repositorio.
# Para el entorno local de docker compose los valores por defecto ya sirven.

# --- Base de datos ---------------------------------------------------------
# Local (docker compose):
POSTGRES_PASSWORD=devpass
POSTGRES_DB=sistemalegal
# Puerto del host para la base. Cambialo si ya tenes otro PostgreSQL en 5432.
PUERTO_DB=5432
# Supabase (produccion): la cadena del POOLER compartido, no la conexion directa.
# Runtime en Render, modo transaccion (puerto 6543):
# DATABASE_URL=postgresql://postgres.abcdefgh:clave@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Migraciones con psql, modo sesion (puerto 5432):
# DATABASE_URL=postgresql://postgres.abcdefgh:clave@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/sistemalegal

# --- Backend ---------------------------------------------------------------
PORT=4000
# Firma de los access token. OBLIGATORIA en produccion: sin ella el servicio no
# arranca, porque un secreto por defecto equivale a no tener firma. Minimo 32
# caracteres. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Vida del access token (minutos) y del refresh token (dias).
MINUTOS_ACCESS_TOKEN=15
DIAS_REFRESH_TOKEN=7
# Limite de intentos fallidos de login por IP y ventana en minutos.
INTENTOS_LOGIN=10
MINUTOS_VENTANA_LOGIN=15
# Limite de intentos fallidos por cuenta (correo) en la misma ventana. No depende
# de la IP, que se puede falsificar llamando a Render sin pasar por Vercel.
INTENTOS_LOGIN_POR_CUENTA=10
# Orígenes autorizados, separados por coma. En producción, el dominio de Vercel.
CORS_ORIGIN=http://localhost:5173
# Prefijo del proyecto en Vercel, para autorizar los dominios de preview.
CORS_PREFIJO_PREVIEW=sistemalegal
# Slug del equipo de Vercel (final del subdominio de un preview:
# sistemalegal-abc123-<slug>.vercel.app). Con el, un proyecto homonimo de otra
# cuenta deja de pasar el CORS. Vacio = solo prefijo (inseguro en produccion).
CORS_SUFIJO_EQUIPO=
LIMITE_LISTADOS=50
# La CA de Supabase vive en backend/certs/supabase-ca.crt y se usa sola.
# Estas dos solo hacen falta si hay que apuntar a otro certificado:
# DATABASE_CA_CERT_PATH=/ruta/al/certificado.crt
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...

# Proxies delante de Express (2 en Render detrás del proxy de Vercel) y SameSite
# de la cookie de sesión. En local no hacen falta.
# SALTOS_PROXY=1
# COOKIE_SAMESITE=lax

# --- Documentos --------------------------------------------------------------
# Microservicio de PDF (pdf-service/). docker compose ya lo configura.
PDF_SERVICE_URL=http://localhost:8000
# PDF_SERVICE_TOKEN=
MEGAS_MAXIMO_ARCHIVO=10
# Supabase Storage (producción). Sin estas, los archivos van a disco local.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=documentos
# ALMACENAMIENTO_DIR=./almacenamiento

# --- Frontend --------------------------------------------------------------
# URL de la API vista desde el navegador, solo en desarrollo. En Vercel NO se
# define: la SPA usa su propio dominio y vercel.json reenvía /api a Render.
VITE_API_URL=http://localhost:4000

# --- Opcional ------------------------------------------------------------------
# CLAUDE_API_KEY=
